rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // 初期管理者（ブートストラップ用）
    // TODO: "your_firebase_uid" を自分の Firebase Authentication UID に置き換えてください
    // 複数人にしたい場合は配列へUIDを追加してください
    function isBootstrapAdmin() {
      return isSignedIn()
        && request.auth.uid in ['u46u17rpgRWZeDY6jhya888qDZU2'];
    }

    function isManagedAdmin(leagueId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/leagues/$(leagueId)/admins/$(request.auth.uid));
    }

    function isLeagueAdmin(leagueId) {
      return isBootstrapAdmin() || isManagedAdmin(leagueId);
    }

    function isValidAdminCreate(adminUid) {
      return request.resource.data.keys().hasOnly(['uid', 'note', 'addedBy', 'createdAt'])
        && request.resource.data.uid == adminUid
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80
        // serverTimestamp() はルール評価時点では型判定で落ちることがあるため request.time で検証
        && request.resource.data.createdAt == request.time;
    }

    match /leagues/{leagueId}/admins/{adminUid} {
      allow get: if isSignedIn()
        && (isBootstrapAdmin() || request.auth.uid == adminUid);
      allow list: if isBootstrapAdmin();
      allow create: if isBootstrapAdmin()
        && adminUid != request.auth.uid
        && !exists(/databases/$(database)/documents/leagues/$(leagueId)/admins/$(adminUid))
        && isValidAdminCreate(adminUid);
      allow update: if false;
      allow delete: if isBootstrapAdmin() && adminUid != request.auth.uid
        || (isSignedIn() && request.auth.uid == adminUid);
    }

    function isValidPlayerCreate(playerId) {
      return request.resource.data.keys().hasOnly(
          ['authUid', 'name', 'icon', 'memo', 'isActive', 'createdAt', 'updatedAt'])
        && playerId == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 4
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 80
        && request.resource.data.isActive == true
        // serverTimestamp() を許可するため request.time と一致させる
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidPlayerUpdate() {
      return (
          !('authUid' in resource.data)
          || request.resource.data.authUid == resource.data.authUid
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 4
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 80
      // 更新時は updatedAt を serverTimestamp() で request.time に合わせる
      && request.resource.data.updatedAt == request.time;
    }

    // 管理者はプレイヤーをBAN（isActiveの切り替え）できる
    // それ以外（authUid / name / icon / memo / createdAt）は変更不可
    function isValidPlayerAdminSetActive() {
      return request.resource.data.authUid == resource.data.authUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == resource.data.name
        && request.resource.data.icon == resource.data.icon
        && request.resource.data.memo == resource.data.memo
        && request.resource.data.updatedAt == request.time
        && request.resource.data.isActive is bool
        && !resource.data.keys().hasAny(['deletedAt']);
    }

    function isValidPlayerProfileFields() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 20
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 4
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 80;
    }

    function isPlayerOwner(playerId) {
      return playerId == request.auth.uid
        && (
          !('authUid' in resource.data)
          || resource.data.authUid == request.auth.uid
        );
    }

    // 本番 main では初期管理者の退会を禁止。テスト用リーグ（dev 等）では検証のため許可
    function canBootstrapAdminSelfDelete(leagueId) {
      return !isBootstrapAdmin() || leagueId != 'main';
    }

    // 本人による退会 — 試合履歴は results に残しプロフィールのみ匿名化
    // leagueId / playerId は match のパス変数を引数で渡す（グローバル関数からの参照は不可）
    function isValidPlayerSelfDelete(leagueId, playerId) {
      return playerId == request.auth.uid
        && isPlayerOwner(playerId)
        && canBootstrapAdminSelfDelete(leagueId)
        && !resource.data.keys().hasAny(['deletedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name == '退会済み'
        && request.resource.data.icon is string
        && request.resource.data.icon.size() >= 1
        && request.resource.data.icon.size() <= 4
        && request.resource.data.memo == ''
        && request.resource.data.isActive == false
        && request.resource.data.deletedAt == request.time
        && request.resource.data.updatedAt == request.time
        && (
          !('authUid' in request.resource.data)
          || request.resource.data.authUid == request.auth.uid
        );
    }

    // 退会後の再登録（deletedAt を除去してプロフィールを復活）
    function isValidPlayerReactivate(playerId) {
      return playerId == request.auth.uid
        && isPlayerOwner(playerId)
        && resource.data.keys().hasAny(['deletedAt'])
        && !request.resource.data.keys().hasAny(['deletedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.isActive == true
        && isValidPlayerProfileFields()
        && request.resource.data.updatedAt == request.time
        && (
          !('authUid' in request.resource.data)
          || request.resource.data.authUid == request.auth.uid
        );
    }

    // players: 閲覧は全員、登録・更新は本人のみ（ドキュメントID = auth UID）
    match /leagues/{leagueId}/players/{playerId} {
      allow read: if true;
      allow create: if isSignedIn()
        && playerId == request.auth.uid
        && isValidPlayerCreate(playerId);
      allow update: if isSignedIn()
        && (
          // 自分自身のプロフィール更新
          (isPlayerOwner(playerId)
            && resource.data.isActive == true
            && !resource.data.keys().hasAny(['deletedAt'])
            && isValidPlayerUpdate())
          // 退会（アカウント削除）
          || isValidPlayerSelfDelete(leagueId, playerId)
          // 退会後の再登録
          || isValidPlayerReactivate(playerId)
          // 管理者BAN/解除（isActiveのみ・退会済みは対象外）
          || (isLeagueAdmin(leagueId) && isValidPlayerAdminSetActive())
        );
      allow delete: if false;

      match /announcementReads/{announcementId} {
        allow read: if isSignedIn() && playerId == request.auth.uid;
        allow create, update: if isSignedIn()
          && playerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow delete: if false;
      }
    }

    // games / results の書き込みは管理者のみ

    match /leagues/{leagueId}/games/{docId} {
      allow read: if true;
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/results/{docId} {
      allow read: if true;
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/counters/{counterId} {
      allow read, write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/seasons/{seasonId} {
      allow read: if true;
      allow write: if isLeagueAdmin(leagueId);
    }

    match /leagues/{leagueId}/config/{docId} {
      allow read: if true;
      allow write: if isLeagueAdmin(leagueId);
    }

    function isValidActivityMemberJoined() {
      return request.resource.data.keys().hasOnly(
          ['type', 'playerId', 'playerName', 'createdAt'])
        && request.resource.data.type == 'member_joined'
        && request.resource.data.playerId == request.auth.uid
        && request.resource.data.playerName is string
        && request.resource.data.playerName.size() > 0
        && request.resource.data.playerName.size() <= 20
        && request.resource.data.createdAt == request.time;
    }

    function isValidActivityGameAdded() {
      return request.resource.data.keys().hasOnly(
          ['type', 'gameId', 'gameNo', 'gameDate', 'gameTime', 'actorUid', 'createdAt'])
        && request.resource.data.type == 'game_added'
        && request.resource.data.gameId is string
        && request.resource.data.gameNo is int
        && request.resource.data.gameNo > 0
        && request.resource.data.gameDate is string
        && request.resource.data.gameDate.size() == 10
        && request.resource.data.gameTime is string
        && request.resource.data.gameTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /leagues/{leagueId}/activities/{activityId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (
          isValidActivityMemberJoined()
          || (isLeagueAdmin(leagueId) && isValidActivityGameAdded())
        );
      allow update, delete: if false;
    }

    function isValidAnnouncementCategory() {
      return request.resource.data.category in ['important', 'update', 'bugfix'];
    }

    function isValidAnnouncementWrite() {
      return isValidAnnouncementCategory()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.isPinned is bool
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidAnnouncementUpdate() {
      return isValidAnnouncementCategory()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 60
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 2000
        && request.resource.data.isPinned is bool
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    match /leagues/{leagueId}/announcements/{announcementId} {
      allow read: if true;
      allow create: if isLeagueAdmin(leagueId) && isValidAnnouncementWrite();
      allow update: if isLeagueAdmin(leagueId) && isValidAnnouncementUpdate();
      allow delete: if isLeagueAdmin(leagueId);
    }
  }
}
